## Ignore Visual Studio temporary files, build results, and files generated by popular add-ons.

# Build output folders
[Bb]in/
[Oo]bj/
Debug/
Release/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

# Visual Studio cache folder
.vs/

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# VS Code settings
.vscode/

# Rider settings
.idea/

# MAUI-specific build results
**/platforms/
**/*.apk
**/*.aab
**/*.app
**/*.ipa
**/*.xcarchive

# NuGet
*.nupkg
*.snupkg
*.nuspec
*.psmdcp
# Ignore packages folder (except build)
**/[Pp]ackages/*
!**/[Pp]ackages/build/
#!**/[Pp]ackages/repositories.config  # Uncomment if needed

# .NET Core / .NET 5+ / .NET 9 build artifacts
project.lock.json
project.fragment.lock.json
artifacts/

# Logs
*.log

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Temporary files
*.tmp
*.temp
*.bak
*.cache
*.swp

# Other dev files
_ReSharper*/
*.DotSettings.user
*.dbmdl
*.jfm
*.pfx
*.publishsettings

# Local settings (keep production config in source)
appsettings.Development.json

# Custom rule: Ignore images in API's wwwroot folder
wwwroot/images/
# Keep everything else in wwwroot
!wwwroot/**

# OS-generated files
.DS_Store
Thumbs.db

# Local environment files
.env
*.env