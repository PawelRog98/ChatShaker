<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatShaker.ChatMauiApp.Views.ChatViewPage"
             xmlns:viewModels="clr-namespace:ChatShaker.ChatMauiApp.ViewModels"
             xmlns:dtos="clr-namespace:ChatShaker.ChatMauiApp.Models.Dto"
             x:DataType="viewModels:ChatViewModel"
             xmlns:prism="http://prismlibrary.com"
             prism:ViewModelLocator.AutowireViewModel="Automatic">

    <ContentView.Content>
        <Grid RowDefinitions="*,Auto" Padding="12">

            <CollectionView 
                Grid.Row="0"
                ItemsSource="{Binding Messages}"
                VerticalOptions="Fill"
                RemainingItemsThreshold="3"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:MessageDto">
                        <Grid Padding="10,2">
                            <Border Padding="12,8"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{StaticResource Gray100}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15,15,15,2" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="HorizontalOptions" Value="End" />
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="StrokeShape">
                                            <Setter.Value>
                                                <RoundRectangle CornerRadius="15,15,2,15" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Border.Triggers>

                                <StackLayout Spacing="2" MinimumWidthRequest="80">
                                    <Label FontSize="11" 
                                           TextColor="{StaticResource Gray600}"
                                           Text="{Binding SenderName}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    
                                    <Label FontSize="15" 
                                           TextColor="Black"
                                           Text="{Binding CipherText}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <StackLayout Orientation="Horizontal" HorizontalOptions="End" Spacing="4">
                                        <Label Text="{Binding SentAtUtc, StringFormat='{0:HH:mm}'}"
                                               FontSize="10" 
                                               TextColor="{StaticResource Gray600}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Gray200}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Status}" 
                                               FontSize="10" 
                                               TextColor="{StaticResource Gray600}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Gray200}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </StackLayout>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0" HeightRequest="50">
                <Border StrokeThickness="1" 
                        Stroke="{StaticResource Gray300}" 
                        Padding="15,0" 
                        StrokeShape="RoundRectangle 25">
                    <Entry 
                        Text="{Binding OngoingText}" 
                        Placeholder="Write your message..."
                        VerticalOptions="Center" />
                </Border>
                
                <Button Grid.Column="1"
                        Text="Send"
                        CornerRadius="25"
                        Command="{Binding SendMessageCommand}" 
                        Margin="8,0,0,0"
                        Padding="20,0"/>
            </Grid>
        </Grid>
    </ContentView.Content>
</ContentView>