<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ChatShaker.ChatMauiApp.ViewModels"
             xmlns:dtos="clr-namespace:ChatShaker.ChatMauiApp.Models.Dto"
             x:DataType="viewModels:RecievedInvitationViewModel"
             xmlns:prism="http://prismlibrary.com"
             prism:ViewModelLocator.AutowireViewModel="Automatic"
             x:Class="ChatShaker.ChatMauiApp.Views.RecievedInvitationPage"
             x:Name="Page"
             Title="Received Invitations">
    <ContentPage.Content>
        <Grid RowDefinitions="Auto, *" Padding="16">
            <Label Grid.Row="0"
                   Text="Received Invitations"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,0,0,16"/>

            <CollectionView Grid.Row="1" 
                            ItemsSource="{Binding RecievedInvitations}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:InvitationDto">
                        <Grid Padding="10" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto">
                            <Label Text="{Binding UserName}"
                                   VerticalOptions="Center"
                                   Grid.Column="0"
                                   Grid.Row="0"/>
                            
                            <Button Grid.Column="1" Grid.Row="0" 
                                    Text="Accept" 
                                    Command="{Binding BindingContext.AcceptCommand, Source={x:Reference Page}}"
                                    CommandParameter="{Binding .}"
                                    Margin="5,0"/>
                            
                            <Button Grid.Column="2" Grid.Row="0" 
                                    Text="Reject" 
                                    Command="{Binding BindingContext.RejectCommand, Source={x:Reference Page}}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Red"
                                    Margin="5,0"/>

                            <Label Text="{Binding SentAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" 
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   FontSize="12"
                                   TextColor="Gray"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No invitations received yet." 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           Margin="0,20,0,0"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>