<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatShaker.ChatMauiApp.Views.Modals.SuccessPopupPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <VerticalStackLayout
        Padding="24"
        Spacing="16">
        <Label 
            Text="Success"
            TextColor="Green"
            FontSize="22"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label x:Name="Message" FontSize="18"/>
        <Button Text="Ok" WidthRequest="120" Clicked="OnCloseClicked"/>
    </VerticalStackLayout>
</toolkit:Popup>