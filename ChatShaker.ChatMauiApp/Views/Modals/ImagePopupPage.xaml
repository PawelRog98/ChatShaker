<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatShaker.ChatMauiApp.Views.Modals.ImagePopupPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <Grid RowDefinitions="Auto, *" BackgroundColor="Black" Padding="10">
        <Button Text="Close" HorizontalOptions="End" Clicked="OnCloseClicked" 
                BackgroundColor="Transparent" TextColor="White" FontSize="18" Padding="10"/>
        <Image x:Name="FullImage" Grid.Row="1" Aspect="AspectFit" Margin="5"/>
    </Grid>
</toolkit:Popup>