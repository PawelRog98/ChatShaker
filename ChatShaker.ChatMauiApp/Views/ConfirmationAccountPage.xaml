<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatShaker.ChatMauiApp.Views.ConfirmationAccountPage"
             xmlns:viewModels="clr-namespace:ChatShaker.ChatMauiApp.ViewModels"
             x:DataType="viewModels:ActivationAccountViewModel"
             xmlns:prism="http://prismlibrary.com"
             prism:ViewModelLocator.AutowireViewModel="Automatic"
             Title="Activation"
             BackgroundColor="{StaticResource Secondary}">
    <Grid>
        <ScrollView>
            <Grid Padding="20">
                <Border VerticalOptions="Start"
                        MaximumWidthRequest="500"
                        Padding="30"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        Margin="0,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.1"/>
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Confirm account"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Primary}"
                               Margin="0,0,0,10"/>
                        
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Code" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray600}" Margin="5,0"/>
                            <Border StrokeThickness="1" Stroke="{StaticResource Gray300}" Padding="15,0" StrokeShape="RoundRectangle 10">
                                <Entry Placeholder="Write your code..." Text="{Binding Code}" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>
                        
                        <Button Text="Send code"
                                Command="{Binding ActivateAccountCommand}"
                                HeightRequest="50"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                Margin="0,10,0,0"/>

                        <Button Text="Resend code"
                                Command="{Binding ResetCodeCommand}"
                                HeightRequest="50"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                BorderColor="{StaticResource Primary}"
                                BorderWidth="1"/>

                        <Label Text="{Binding CooldownSeconds, StringFormat='Wait for {0} seconds'}"
                               IsVisible="{Binding IsCooldownActive}"
                               HorizontalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource Gray600}"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
            
        </ScrollView>

        <Grid BackgroundColor="#80FFFFFF" 
              IsVisible="{Binding IsBusy}"
              InputTransparent="False">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               WidthRequest="60"
                               HeightRequest="60"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>