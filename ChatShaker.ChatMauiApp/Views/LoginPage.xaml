<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatShaker.ChatMauiApp.Views.LoginPage"
             xmlns:viewModels="clr-namespace:ChatShaker.ChatMauiApp.ViewModels"
             x:DataType="viewModels:LoginPageViewModel"
             xmlns:prism="http://prismlibrary.com"
             prism:ViewModelLocator.AutowireViewModel="Automatic"
             Title="Login"
             BackgroundColor="{StaticResource Secondary}">

    <ScrollView>
        <Grid MinimumHeightRequest="600" Padding="20">
            <Border VerticalOptions="Center"
                    MaximumWidthRequest="400"
                    Padding="30"
                    StrokeThickness="0"
                    BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.1" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">
                    <Label Text="Welcome Back"
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Primary}"
                           Margin="0,10,0,0" />

                    <Label Text="Sign in to continue"
                           FontSize="16"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Gray500}"
                           Margin="0,0,0,20" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Email" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="{StaticResource Gray600}" 
                               Margin="5,0"/>
                        <Border StrokeThickness="1" 
                                Stroke="{StaticResource Gray300}" 
                                Padding="15,0" 
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="White">
                            <Entry Placeholder="Enter your email" 
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   BackgroundColor="Transparent" />
                        </Border>
                        <Label Text="{Binding EmailError}" 
                               TextColor="Red" 
                               FontSize="12"
                               Margin="5,0">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding EmailError}" Value="">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="{StaticResource Gray600}" 
                               Margin="5,0"/>
                        <Border StrokeThickness="1" 
                                Stroke="{StaticResource Gray300}" 
                                Padding="15,0" 
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="White">
                            <Entry Placeholder="Enter your password" 
                                   IsPassword="True" 
                                   Text="{Binding Password}"
                                   BackgroundColor="Transparent" />
                        </Border>
                        <Label Text="{Binding PasswordError}" 
                               TextColor="Red" 
                               FontSize="12"
                               Margin="5,0">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding PasswordError}" Value="">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>

                    <Button Text="Login" 
                            Command="{Binding LoginCommand}"
                            HeightRequest="50"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            Margin="0,10,0,0" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label Text="Don't have an account?" VerticalOptions="Center" />
                        <Button Text="Register now!" 
                                Command="{Binding MoveToRegisterCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                Padding="0"
                                HeightRequest="30"
                                VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>