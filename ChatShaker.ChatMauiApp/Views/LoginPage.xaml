<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatShaker.ChatMauiApp.Views.LoginPage"
             xmlns:viewModels="clr-namespace:ChatShaker.ChatMauiApp.ViewModels"
             x:DataType="viewModels:LoginPageViewModel"
             xmlns:prism="http://prismlibrary.com"
             prism:ViewModelLocator.AutowireViewModel="Automatic"
             Title="LoginPage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label Text="{Binding EmailError}" TextColor="Red">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding EmailError}" Value="">
                    <Setter Property="IsVisible" Value="False"/>
                </DataTrigger>
            </Label.Triggers>
        </Label>
        <Entry Placeholder="Email" Text="{Binding Email}"/>

        <Label Text="{Binding PasswordError}" TextColor="Red">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding PasswordError}" Value="">
                    <Setter Property="IsVisible" Value="False"/>
                </DataTrigger>
            </Label.Triggers>
        </Label>
        <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />
        <Button Text="Login" Command="{Binding LoginCommand}"/>
        <Button Text="Register now!" BackgroundColor="PaleVioletRed" Command="{Binding MoveToRegisterCommand}"/>
    </VerticalStackLayout>
</ContentPage>