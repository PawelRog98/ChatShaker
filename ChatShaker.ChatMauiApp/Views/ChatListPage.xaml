<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatShaker.ChatMauiApp.Views.ChatListPage"
             x:Name="page"
             xmlns:viewModels="clr-namespace:ChatShaker.ChatMauiApp.ViewModels"
             xmlns:views="clr-namespace:ChatShaker.ChatMauiApp.Views"
             xmlns:dtos="clr-namespace:ChatShaker.ChatMauiApp.Models.Dto"
             x:DataType="viewModels:ChatListViewModel"
             xmlns:prism="http://prismlibrary.com"
             prism:ViewModelLocator.AutowireViewModel="Automatic">
    <ContentView.Content>
        <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">
            <Border Grid.Row="0" 
                    StrokeThickness="1" 
                    Stroke="{StaticResource Gray300}" 
                    Padding="12,0" 
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="White">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Text="🔍" VerticalOptions="Center" Margin="0,0,8,0" />
                    <Entry Grid.Column="1" 
                           Text="{Binding Name}" 
                           Placeholder="Search chats..." 
                           BackgroundColor="Transparent" />
                </Grid>
            </Border>
            
            <CollectionView 
                Grid.Row="1"
                ItemsSource="{Binding Chats}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ChatListItem">
                        <Border StrokeThickness="0" 
                                BackgroundColor="White" 
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.05" />
                            </Border.Shadow>
                            
                            <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" 
                                        HeightRequest="50" 
                                        WidthRequest="50" 
                                        BackgroundColor="{StaticResource Secondary}"
                                        StrokeShape="RoundRectangle 25">
                                    <Label Text="{Binding Name[0]}" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           TextColor="{StaticResource Primary}" 
                                           FontAttributes="Bold" 
                                           FontSize="20" />
                                </Border>

                                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="{StaticResource Gray900}" />
                                    <Label Text="{Binding LastMessagePreview}" 
                                           FontSize="14" 
                                           TextColor="{StaticResource Gray600}" 
                                           MaxLines="1" 
                                           LineBreakMode="TailTruncation">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsRead}" Value="False">
                                                <Setter Property="FontAttributes" Value="Bold" />
                                                <Setter Property="TextColor" Value="{StaticResource Gray900}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </StackLayout>

                                <StackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="4">
                                    <Label Text="{Binding LastMessageDate, StringFormat='{0:HH:mm}'}" 
                                           FontSize="12" 
                                           TextColor="{StaticResource Gray400}" />
                                    <Ellipse WidthRequest="10" 
                                             HeightRequest="10" 
                                             Fill="{StaticResource Primary}" 
                                             HorizontalOptions="End" 
                                             IsVisible="False">
                                        <Ellipse.Triggers>
                                            <DataTrigger TargetType="Ellipse" Binding="{Binding IsRead}" Value="False">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </StackLayout>
                            </Grid>
                        
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.OpenChatCommand, Source={x:Reference page}}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentView.Content>
</ContentView>