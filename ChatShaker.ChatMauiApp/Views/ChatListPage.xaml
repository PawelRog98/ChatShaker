<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatShaker.ChatMauiApp.Views.ChatListPage"
             x:Name="page"
             xmlns:viewModels="clr-namespace:ChatShaker.ChatMauiApp.ViewModels"
             xmlns:dtos="clr-namespace:ChatShaker.ChatMauiApp.Models.Dto"
             x:DataType="viewModels:ChatListViewModel"
             xmlns:prism="http://prismlibrary.com"
             prism:ViewModelLocator.AutowireViewModel="Automatic">
    <ContentView.Content>
        <Grid RowDefinitions="Auto,*" Padding="12">
            <Entry Grid.Row="0" Text="{Binding Name}" Placeholder="Search..."></Entry>
            
            <CollectionView 
                Grid.Row="1"
                ItemsSource="{Binding Chats}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ChatListItem">
                        <Grid Padding="12" ColumnDefinitions="*,Auto">
                            <StackLayout>
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold"></Label>
                                <Label Text="{Binding LastMessagePreview}" FontSize="16" TextColor="Gray"></Label>
                            </StackLayout>
                        
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.OpenChatCommand, Source={x:Reference page}}"
                                                      CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentView.Content>
</ContentView>